				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[SEÑOR/A:]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Transparent" x="344" y="78" width="75" height="20" uuid="f14c017a-cff8-446e-8939-ea6db088d913"/>
