	<subDataset name="fecha" uuid="ce79bc98-370a-4308-845e-18a52c210bac">
		<parameter name="fecha_inicial" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{fecha_inicial}]]></defaultValueExpression>
		</parameter>
		<parameter name="fecha_final" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{fecha_final}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT fecha_viaje,SUM(cantidad ) AS cantidad FROM `vistaimprimircantidadpasajeros` WHERE fecha_viaje BETWEEN $P{fecha_inicial} AND $P{fecha_final} GROUP BY fecha_viaje]]>
		</queryString>
		<field name="fecha_viaje" class="java.sql.Date">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="cantidad" class="java.math.BigDecimal">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
	</subDataset>
	<subDataset name="horarios" uuid="c20fe6f7-5065-438f-ba88-da03ac29de84">
		<parameter name="fecha_inicial" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{fecha_inicial}]]></defaultValueExpression>
		</parameter>
		<parameter name="fecha_final" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{fecha_final}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT horario,SUM(cantidad ) AS Cantidad FROM `vistaimprimircantidadpasajeros` WHERE fecha_viaje BETWEEN $P{fecha_inicial} AND $P{fecha_final} GROUP BY horario]]>
		</queryString>
		<field name="horario" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="cantidad" class="java.math.BigDecimal">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
	</subDataset>
