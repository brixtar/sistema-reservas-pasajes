	<subDataset name="fecha" uuid="ce79bc98-370a-4308-845e-18a52c210bac">
		<parameter name="fecha_inicial" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{fecha_inicial}]]></defaultValueExpression>
		</parameter>
		<parameter name="fecha_final" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{fecha_final}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT forma , SUM(monto) AS monto FROM vistacomision WHERE fecha BETWEEN $P{fecha_inicial} AND $P{fecha_final} GROUP BY forma]]>
		</queryString>
		<field name="forma" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="monto" class="java.math.BigDecimal">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
	</subDataset>
